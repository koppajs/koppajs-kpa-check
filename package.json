{
  "name": "@koppajs/kpa-check",
  "version": "0.1.0",
  "description": "CLI diagnostics runner for KoppaJS .kpa files.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/koppajs/kpa-check"
  },
  "bin": {
    "kpa-check": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "validate": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@koppajs/language-core": "file:../language-core"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "^5.3.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
